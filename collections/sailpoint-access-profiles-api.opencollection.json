              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Update an existing access profile using a JSON Patch document. The maximum supported length for the description field is 2000 characters."
        },
        {
